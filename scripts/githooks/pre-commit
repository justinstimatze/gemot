#!/bin/bash
# Gemot pre-commit hook. Tracked in scripts/githooks/. Wire up with:
#
#   ./scripts/install-githooks.sh
#
# Runs editorial / health checks on staged content. Soft-warns by default;
# hard-fails only on structural drift that would break a release. Anything
# enforced here is also covered by the test suite, so this hook is for
# fast feedback, not the source of truth.

set -uo pipefail

# 1. CodeScene delta analysis (warning only, requires `cs` CLI)
if command -v cs &> /dev/null; then
  if ! cs delta --staged > /dev/null 2>&1; then
    echo "⚠️  CodeScene flagged code-health issues on staged changes (warning, not blocking)."
  fi
fi

# 2. CHANGELOG-touched nudge: when production internal/ Go code changes
#    without a CHANGELOG.md update in the same commit, surface a reminder.
#    Test-only changes are exempt — they don't need release notes.
if git diff --cached --name-only | grep -E '^internal/.*\.go$' | grep -vqE '_test\.go$'; then
  if ! git diff --cached --name-only | grep -q '^CHANGELOG\.md$'; then
    echo "ℹ️  internal/ production code changed but CHANGELOG.md isn't staged — "
    echo "    add a line to the Unreleased section if this commit is user-visible."
  fi
fi

# 3. gofmt sanity: catch the formatting issues that golangci-lint flags
#    on CI before the commit lands. CI failures from gofmt drift went
#    unnoticed for a week (b0bafcc → eff05bc) because nothing local ran
#    gofmt. Hard-fails on staged Go files only, so the hook stays fast
#    even with pre-existing drift in untouched parts of the repo.
staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.go$' || true)
if [[ -n "$staged_go" ]]; then
  unfmt=$(gofmt -l $staged_go 2>/dev/null || true)
  if [[ -n "$unfmt" ]]; then
    echo "❌ gofmt issues in staged files:"
    echo "$unfmt" | sed 's/^/    /'
    echo "    Fix with: gofmt -w $unfmt"
    exit 1
  fi
fi

# 4. Version-sync sanity: if Version constant or server.json was touched,
#    make sure they still match. Read the *staged* contents (not the
#    working tree) so unstaged edits in either file don't fool the check.
#    Hard-fails the commit on drift; the Go test enforces this on full
#    test runs but pre-commit catches it before the CI roundtrip.
if git diff --cached --name-only | grep -qE '^(internal/mcp/server\.go|server\.json)$'; then
  STAGED_GO=$(git show ":internal/mcp/server.go" 2>/dev/null | grep -E '^const Version = ' | sed -E 's/.*"([^"]+)".*/\1/')
  STAGED_JSON=$(git show ":server.json" 2>/dev/null | jq -r '.version' 2>/dev/null)
  if [[ -n "$STAGED_GO" && -n "$STAGED_JSON" && "$STAGED_GO" != "$STAGED_JSON" ]]; then
    echo "❌ Staged version drift: server.go=$STAGED_GO server.json=$STAGED_JSON — run scripts/bump-version.sh."
    exit 1
  fi
fi

# 5. go vet sanity: cheap, catches obvious bugs (printf args, unreachable
#    code, lock copies). Hard fail. Skipped if `go` isn't on PATH so the
#    hook stays portable to non-Go contributors.
if command -v go &>/dev/null && [[ -n "$staged_go" ]]; then
  if ! go vet ./... > /tmp/gemot-vet.log 2>&1; then
    echo "❌ go vet ./... failed:"
    sed 's/^/    /' /tmp/gemot-vet.log
    rm -f /tmp/gemot-vet.log
    exit 1
  fi
  rm -f /tmp/gemot-vet.log
fi

exit 0
